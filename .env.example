# Render PostgreSQL. Use its External Database URL in Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
NEXT_PUBLIC_APP_URL=http://localhost:3000
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_CERTIFICATE_BASE64=
APPLE_PASS_CERTIFICATE_PASSWORD=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
CUSTOMER_SESSION_SECRET=replace-with-a-long-random-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Meta Conversions API. Keep disabled until the matching Pixel ID and token are configured.
META_PURCHASE_TRACKING_ENABLED=false
META_PIXEL_ID=
META_CONVERSIONS_API_ACCESS_TOKEN=
# Optional. Set only while validating in Meta Events Manager > Test Events.
META_TEST_EVENT_CODE=
FIDELIZAREI_TRIAL_COUPON_CODE=troque-por-um-cupom-secreto
PLATFORM_ADMIN_EMAIL=admin@fidelizarei.com
